# ============================================================================
# DoAide AutoApply environment configuration — copy to .env and fill in real values.
# .env is gitignored. NEVER commit real secrets.
# ============================================================================

# ---- App ----
APP_NAME=DoAide AutoApply
ENVIRONMENT=development           # development | production
DEBUG=true
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins for the frontend
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Security / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24h

# ---- Database ----
# Docker compose sets this automatically; override for local runs.
DATABASE_URL=postgresql+psycopg://talentping:talentping@localhost:5432/talentping

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Set false to run campaign work inline in the request instead of on a worker
# (single-process deployments and tests). Production runs workers: leave true.
CELERY_ENABLED=true

# ---- AI (OpenRouter — use FREE models, not Anthropic directly) ----
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_CLASSIFIER_MODEL=openai/gpt-oss-20b:free
# Optional attribution headers OpenRouter recommends
OPENROUTER_APP_URL=https://job.doaide.com
OPENROUTER_APP_TITLE=DoAide AutoApply

# ---- AI fallback chain ----
# Tried in order after OpenRouter: Gemini -> Groq -> Cerebras -> static template.
# All speak the OpenAI chat-completions dialect; a provider with a blank key is
# skipped, so you can configure as few or as many as you like. Every one of
# these has a usable free tier. More configured = fewer static-template
# fallbacks when an upstream has a bad day.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b

# Circuit breaker: skip a provider for this long after this many consecutive
# failures, so one dead upstream costs a timeout once rather than every call.
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN_SECONDS=300

# ---- Frontend ----
# Where the OAuth popup posts its result back to. Must match the site origin.
FRONTEND_URL=http://localhost:5173

# ---- Gmail OAuth (per-user, authorization-code flow) ----
# Google Cloud OAuth 2.0 "Web application" client. The redirect URI below must
# be registered on that client verbatim. See docs/GOOGLE-OAUTH-SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback
# Encrypts OAuth refresh tokens at rest. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this invalidates every stored token — users must reconnect.
TOKEN_ENCRYPTION_KEY=

# ---- Sending / warm-up limits (safe cold-outreach defaults) ----
DAILY_SEND_LIMIT=30               # per mailbox per rolling 24h
MIN_SEND_INTERVAL_SECONDS=90      # randomized throttle floor
MAX_SEND_INTERVAL_SECONDS=600     # randomized throttle ceiling

# ---- CAN-SPAM compliance (required in every outbound email) ----
COMPLIANCE_PHYSICAL_ADDRESS=123 Example St, Suite 100, San Francisco, CA 94105
COMPLIANCE_UNSUBSCRIBE_BASE_URL=http://localhost:8000/api/v1/unsubscribe

# ---- Gmail push notifications (Cloud Pub/Sub) ----
# Provisioned by ./scripts/setup_gmail_pubsub.sh, which prints these three lines.
# Empty TOPIC means push is off and every watched mailbox is polled on the beat
# schedule below — slower, never silent, and always correct.
GMAIL_PUBSUB_PROJECT=metal-cascade-500017-k3
GMAIL_PUBSUB_TOPIC=
# Shared secret Pub/Sub appends to the webhook URL as ?token=…. The webhook is
# necessarily unauthenticated (Pub/Sub has no user session), so this is the only
# gate on it. Stored in keys/gmail_pubsub_token.txt.
GMAIL_PUBSUB_TOKEN=

# ---- Inbound recruiter mail ----
RECRUITER_REPLY_ENABLED=false      # the feature's off switch
RECRUITER_REPLY_AUTO_ENABLED=false # allow replies to send unreviewed
# The beat sweep is a *fallback*: Gmail push detects mail in seconds, and a
# mailbox with a healthy, delivering subscription is skipped by this tick
# entirely. Five minutes is what a mailbox waits when push is off or has gone
# quiet. Lower it back to 60 to disable push-first behaviour in an emergency.
RECRUITER_SCAN_INTERVAL_SECONDS=300
# How long push's silence is still trusted before the sweep covers the mailbox
# anyway. An "active" watch is not evidence of delivery — Google stops
# publishing without an error — so this is the safety margin on push-first.
RECRUITER_PUSH_TRUST_SECONDS=900

# ---- Learning from your verdicts on drafts ----
# Approving or discarding a draft adjusts how confidently the next message from
# that sender is read. Bounded and asymmetric: a boost can never on its own
# promote a message from "draft for review" into "send unreviewed".
RECRUITER_FEEDBACK_ENABLED=true
RECRUITER_FEEDBACK_MAX_BOOST=0.10
RECRUITER_FEEDBACK_MAX_PENALTY=0.30

# ---- Smart resume selection ----
# Pick the resume that argues best for the role in the recruiter's email rather
# than the matched profile's default. Only changes which PDF travels.
RECRUITER_SMART_RESUME_ENABLED=true
RECRUITER_RESUME_SWITCH_MARGIN=5.0
